rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSession(data) {
      return data.sessionId is string
        && data.sessionId.size() > 0
        && data.sessionId.size() <= 128
        && (!('wishText' in data) || (data.wishText is string && data.wishText.size() <= 1000))
        && (!('videoAssetId' in data) || (data.videoAssetId is string && data.videoAssetId.size() <= 256))
        && (!('videoSecureUrl' in data) || (data.videoSecureUrl is string && data.videoSecureUrl.size() <= 1000))
        && (!('audioAssetId' in data) || (data.audioAssetId is string && data.audioAssetId.size() <= 256))
        && (!('audioSecureUrl' in data) || (data.audioSecureUrl is string && data.audioSecureUrl.size() <= 1000))
        && (!('recordingStatus' in data) || (data.recordingStatus is string && data.recordingStatus.size() <= 32));
    }

    // Diwali Quest participant experience sessions
    match /experienceSessions/{sessionId} {
      allow create: if isValidId(sessionId)
        && request.resource.data.sessionId == sessionId
        && isValidSession(request.resource.data);

      allow update: if isValidId(sessionId)
        && request.resource.data.sessionId == sessionId
        && isValidSession(request.resource.data);

      allow read, delete: if isValidId(sessionId);
    }
  }
}
